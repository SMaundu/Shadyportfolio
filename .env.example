# Copy this file to .env for local development (never commit .env).
# In production, set the same variables in Netlify:
#   Site configuration -> Environment variables
# See docs/BACKEND.md for step-by-step setup.

# ---------------------------------------------------------------- Supabase
# Project Settings -> API. The service-role key is SECRET: server-side only.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- Resend
# resend.com -> API Keys (sending access is enough).
RESEND_API_KEY=
# Without a verified domain, keep onboarding@resend.dev. Resend then only
# delivers to the email address you signed up to Resend with.
RESEND_FROM=Shadrack Maundu Portfolio <onboarding@resend.dev>
NOTIFY_EMAIL=shadrackmaundu007@gmail.com
# Set to true only after RESEND_FROM uses your own verified domain,
# e.g. RESEND_FROM=Shadrack Maundu <hello@yourdomain.com>
SEND_VISITOR_CONFIRMATION=false

# ------------------------------------------------------- Spam / rate limit
# Any long random string, e.g. output of: openssl rand -hex 32
RATE_LIMIT_SALT=

# ----------------------------------------------------------------- Cal.com
# Public booking link (username/event-slug). Exposed to the browser on purpose.
VITE_CAL_LINK=
# Secret you type when creating the Cal.com webhook (Settings -> Developer -> Webhooks).
CAL_WEBHOOK_SECRET=
# Only for Cal.com EU / self-hosted:
# VITE_CAL_ORIGIN=https://cal.eu
# VITE_CAL_EMBED_JS=https://app.cal.eu/embed/embed.js

# Optional: extra origins allowed to POST to /api/enquiry (comma separated)
# ALLOWED_ORIGINS=https://www.yourdomain.com
